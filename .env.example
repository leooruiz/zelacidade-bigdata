# Copie para .env (o .env fica fora do Git). Só vale para o Airflow local no seu PC.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
# Qualquer texto longo e aleatório (por exemplo, gerado no https://www.random.org/strings/)
AIRFLOW_JWT_SECRET=CHANGE_ME

# A URL do MVP e a EXPORT_API_KEY NÃO ficam aqui: cadastre-as no Airflow em Admin > Variables
# (ZELA_API_URL e ZELA_API_KEY), como pede o requisito 03.
